#include <stdio.h> 
// Function to print the current state of the array 
void printArray(int A[], int n) 
{ 
for (int i = 0; i < n; i++) 
{ 
printf("%d ", A[i]); 
} 
printf("\n"); 
} 
void selectionSort(int A[], int n) 
{ 
int i, j, min, temp; 
int swapCount = 1; // Counter to keep track of passes 
for (i = 0; i < n - 1; i++) 
{ 
min = i; 
for (j = i + 1; j < n; j++) 
{ 
if (A[j] < A[min]) 
{ 
min = j; 
} 
} 
// Swap the found minimum element with the first unsorted element 
printf("Swap %d: Swapping %d and %d -> ", swapCount++, A[i], A[min]); 
temp = A[i]; 
A[i] = A[min]; 
A[min] = temp; 
// Print the array immediately after the swap 
printArray(A, n); 
} 
} 
int main() 
{ 
int n; 
printf("Enter the number of elements: "); 
scanf("%d", &n); 
int A[n]; 
printf("Enter %d elements:\n", n); 
for (int i = 0; i < n; i++) 
{ 
scanf("%d", &A[i]); 
} 
printf("\nInitial Array: "); 
printArray(A, n); 
printf("---------------------------------------\n"); 
selectionSort(A, n); 
printf("---------------------------------------\n"); 
printf("Final Sorted Array: "); 
printArray(A, n); 
return 0; 
}
